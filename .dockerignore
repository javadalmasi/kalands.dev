.git
.gitignore
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
.fleet/
*.swp
*.swo
*.swn
*.bak
*.tmp
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Dependencies
/vendor
/node_modules
/.pnp
.pnp.js

# Build artifacts
/public/build
/public/hot
/public/mix-manifest.json
/public/assets
/public/uploads

# Laravel runtime
/storage/*.key
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache
/storage/framework/sessions
/storage/framework/views
/storage/framework/testing
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep

# Database
*.sqlite
*.sqlite3
*.db

# Backups and large files
/storage/app/backups/*
/storage/app/geoip/*.mmdb

# Sitemap generated files
/public/sitemap.xml
/public/sitemaps/*

# Test and coverage
/.phpunit.result.cache
/.qwen/*
/coverage
.phpunit.cache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.pachim.json
boost.json
